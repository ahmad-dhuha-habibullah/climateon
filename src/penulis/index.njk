---
layout: layouts/base.njk
title: "Tim Penulis - ClimateOn"
description: "Kenali tim penulis dan kontributor di balik ClimateOn."
permalink: /penulis/
---

<section class="kategori-header">
    <div class="container">
        {% include "components/breadcrumb.njk" %}
        <br>
        <h1>Tim Penulis</h1>
        <p class="kategori-desc">Para profesional di bidang iklim, meteorologi, dan komunikasi sains yang menggerakkan ClimateOn.</p>
    </div>
</section>

<section class="section">
    <div class="container">
        <div class="penulis-grid">
            {% for author in collections.penulis %}
            <div class="penulis-card">
                <div class="penulis-card-avatar">
                    <img src="{{ author.data.avatar | default('/assets/images/authors/default.jpg') }}" alt="{{ author.data.title }}" loading="lazy">
                </div>
                <div class="penulis-card-body">
                    <h3><a href="{{ author.url }}" style="color: inherit; text-decoration: none;">{{ author.data.title }}</a></h3>
                    <span class="penulis-peran-badge">{{ author.data.peran }}</span>
                    <div class="penulis-bio-preview">{{ author.content | striptags | truncate(150) }}</div>
                    <div class="penulis-sosial">
                        {% if author.data.twitter %}
                        <a href="{{ author.data.twitter }}" target="_blank" rel="noopener"><i data-lucide="twitter" class="icon-sm"></i></a>
                        {% endif %}
                        {% if author.data.linkedin %}
                        <a href="{{ author.data.linkedin }}" target="_blank" rel="noopener"><i data-lucide="linkedin" class="icon-sm"></i></a>
                        {% endif %}
                        {% if author.data.instagram %}
                        <a href="{{ author.data.instagram }}" target="_blank" rel="noopener"><i data-lucide="instagram" class="icon-sm"></i></a>
                        {% endif %}
                    </div>
                </div>
            </div>
            {% endfor %}
        </div>
    </div>
</section>
