{# Newsletter CTA Section #}
<section class="newsletter-section">
    <div class="container">
        <div class="newsletter-card">
            <div class="newsletter-content">
                <i data-lucide="mail" class="newsletter-icon"></i>
                <h2>Tetap Terinformasi</h2>
                <p>Dapatkan analisis iklim terbaru, ringkasan riset, dan pembaruan data langsung ke kotak masuk Anda. Gratis, tanpa spam.</p>
                <form class="newsletter-form" onsubmit="event.preventDefault(); alert('Terima kasih! Fitur newsletter akan segera aktif.');">
                    <input type="email" placeholder="alamat@email.com" required class="newsletter-input" aria-label="Alamat email">
                    <button type="submit" class="newsletter-btn">
                        <i data-lucide="send" class="icon-sm"></i>
                        Berlangganan
                    </button>
                </form>
            </div>
        </div>
    </div>
</section>

