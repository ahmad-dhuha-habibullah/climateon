{# Seksi Kategori - Homepage category block #}
{# Expects: sectionTitle, sectionUrl, items (array of articles), maxItems (default 3) #}
<section class="section seksi-kategori">
    <div class="container">
        <div class="section-title">
            <h2>{{ sectionTitle }}</h2>
            <a href="{{ sectionUrl }}" class="section-link">
                Lihat Semua <i data-lucide="arrow-right" class="icon-xs"></i>
            </a>
        </div>
        <div class="grid-cards grid-3">
            {% set limitItems = maxItems | default(3) %}
            {% for item in items | limit(limitItems) %}
                {% include "components/kartu-standar.njk" %}
            {% endfor %}
        </div>
    </div>
</section>

