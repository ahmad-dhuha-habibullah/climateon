<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ title | default("Climateon.id - Memahami Iklim, Memahami Masa Depan") }}</title>
    <meta name="description" content="{{ description | default('Platform informasi iklim Indonesia yang menyajikan penjelasan, analisis, visualisasi data, dan pemantauan kondisi iklim secara mudah dipahami.') }}">
    
    <!-- CSS -->
    <link rel="stylesheet" href="/assets/css/style.css">
    
    <!-- Favicon -->
    <link rel="icon" type="image/png" href="/climateon_logo.png">

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Merriweather:ital,wght@0,300;0,400;0,700;1,300&display=swap" rel="stylesheet">
    
    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>
</head>

<body>

    <!-- Navigation -->
    <header class="site-header">
        <div class="container header-container">
            <!-- Logo -->
            <a href="/" class="site-logo">
                <img src="/climateon_logo.png" alt="Climateon.id Logo">
            </a>

            <!-- Desktop Nav -->
            <nav class="main-nav" id="main-nav">
                <a href="/" class="{% if page.url == '/' %}active{% endif %}">Beranda</a>
                <a href="/iklim-dijelaskan/" class="{% if '/iklim-dijelaskan/' in page.url %}active{% endif %}">Memahami Iklim</a>
                <a href="/climate-watch/" class="{% if '/climate-watch/' in page.url %}active{% endif %}">Climate Watch</a>
                <a href="/data-story/" class="{% if '/data-story/' in page.url %}active{% endif %}">Data Story</a>
                <a href="/bedah-paper/" class="{% if '/bedah-paper/' in page.url %}active{% endif %}">Bedah Paper</a>
                <a href="/peristiwa-ekstrem/" class="{% if '/peristiwa-ekstrem/' in page.url %}active{% endif %}">Peristiwa Ekstrem</a>
                <a href="/solusi-adaptasi/" class="{% if '/solusi-adaptasi/' in page.url %}active{% endif %}">Solusi & Adaptasi</a>
                <a href="/eksplorasi/" class="{% if '/eksplorasi/' in page.url %}active{% endif %}">Eksplorasi</a>
                <a href="/tentang/" class="{% if '/tentang/' in page.url %}active{% endif %}">Tentang</a>
            </nav>

            <!-- Mobile Menu Toggle -->
            <button class="menu-toggle" id="mobile-menu-btn" aria-label="Toggle menu">
                <i data-lucide="menu"></i>
            </button>
        </div>
    </header>

    <!-- Main Content Area -->
    <main id="app-root">
        {{ content | safe }}
    </main>

    <!-- Footer -->
    <footer class="site-footer">
        <div class="container">
            <div class="footer-content">
                <div class="footer-brand">
                    <div style="display:flex; align-items:center; gap:0.5rem; margin-bottom:1rem;">
                        <img src="/climateon_logo.png" alt="Climateon Logo" style="height:32px;">
                    </div>
                    <p>Platform informasi iklim Indonesia yang menyajikan penjelasan, analisis, visualisasi data, dan pemantauan kondisi iklim secara mudah dipahami.</p>
                </div>

                <div class="footer-links">
                    <h4>Kategori</h4>
                    <ul>
                        <li><a href="/iklim-dijelaskan/">Memahami Iklim</a></li>
                        <li><a href="/climate-watch/">Climate Watch</a></li>
                        <li><a href="/data-story/">Data Story</a></li>
                        <li><a href="/bedah-paper/">Bedah Paper</a></li>
                        <li><a href="/peristiwa-ekstrem/">Peristiwa Ekstrem</a></li>
                    </ul>
                </div>

                <div class="footer-links">
                    <h4>Tentang Kami</h4>
                    <ul>
                        <li><a href="/tentang/">Tentang Climateon.id</a></li>
                        <li><a href="/tentang/">Kontak</a></li>
                        <li><a href="#">Kebijakan Privasi</a></li>
                    </ul>
                </div>
            </div>

            <div class="footer-bottom">
                &copy; 2026 Climateon.id - Memahami Iklim, Memahami Masa Depan.
            </div>
        </div>
    </footer>

    <script>
        lucide.createIcons();

        // Mobile menu
        const menuBtn = document.getElementById('mobile-menu-btn');
        const mainNav = document.getElementById('main-nav');
        if (menuBtn && mainNav) {
            menuBtn.addEventListener('click', () => {
                mainNav.classList.toggle('active');
            });
        }
    </script>
</body>
</html>
