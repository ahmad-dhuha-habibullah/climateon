---
layout: layouts/base.njk
---
<article class="article-header">
    <div class="container">
        {% if kategori %}
            <span class="article-category">{{ kategori }}</span>
        {% endif %}
        
        <h1 class="article-title">{{ title }}</h1>
        
        <div class="article-meta">
            <span>{{ date | readableDate }}</span>
            {% if penulis %}
                <span>&bull;</span>
                <span>Oleh {{ penulis }}</span>
            {% endif %}
        </div>
    </div>
</article>

<div class="container" style="max-width: 800px; padding-bottom: 4rem;">
    {% if image %}
        <img src="{{ image }}" alt="{{ title }}" class="article-cover">
    {% endif %}

    <div class="article-content">
        {% if penulis and jurnal and tahun %}
            <div class="paper-meta-box">
                <h3>Informasi Paper</h3>
                <ul>
                    <li><strong>Penulis:</strong> {{ penulis }}</li>
                    <li><strong>Tahun:</strong> {{ tahun }}</li>
                    <li><strong>Jurnal:</strong> {{ jurnal }}</li>
                    {% if doi %}
                    <li><strong>DOI:</strong> <a href="https://doi.org/{{ doi }}" target="_blank">{{ doi }}</a></li>
                    {% endif %}
                </ul>
            </div>
        {% endif %}

        {{ content | safe }}
    </div>
</div>
