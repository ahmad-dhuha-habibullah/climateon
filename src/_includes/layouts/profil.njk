---
layout: layouts/base.njk
eleventyComputed:
  title: "{{ title }} "
  description: "{{ content | striptags | truncate(120) }}"
---

<div class="profil-page">
    
    {# ═══ Hero Banner ═══ #}
    <div class="profil-hero" {% if avatar %}style="--author-avatar: url('{{ avatar }}')"{% endif %}>
        <div class="profil-hero-bg"></div>
        <div class="container profil-hero-content">
            <div class="profil-avatar-ring">
                <img src="{{ avatar | default('/assets/images/authors/default.jpg') }}" 
                     alt="{{ title }}" 
                     class="profil-avatar-img" loading="lazy">
            </div>
            <div class="profil-hero-info">
                <span class="profil-peran-badge">{{ peran | default('Kontributor') }}</span>
                <h1 class="profil-nama">{{ title }}</h1>
                {% if keahlian %}
                <p class="profil-keahlian">{{ keahlian }}</p>
                {% endif %}
                <div class="profil-sosial">
                    {% if instagram %}
                    <a href="{{ instagram | ensureUrl }}" target="_blank" rel="noopener" class="profil-sosial-btn" aria-label="Instagram">
                        <i data-lucide="instagram"></i> Instagram
                    </a>
                    {% endif %}
                    {% if linkedin %}
                    <a href="{{ linkedin | ensureUrl }}" target="_blank" rel="noopener" class="profil-sosial-btn" aria-label="LinkedIn">
                        <i data-lucide="linkedin"></i> LinkedIn
                    </a>
                    {% endif %}
                    {% if threads %}
                    <a href="{{ threads | ensureUrl }}" target="_blank" rel="noopener" class="profil-sosial-btn" aria-label="Threads">
                        <i data-lucide="at-sign"></i> Threads
                    </a>
                    {% endif %}
                    {% if tiktok %}
                    <a href="{{ tiktok | ensureUrl }}" target="_blank" rel="noopener" class="profil-sosial-btn" aria-label="TikTok">
                        <i data-lucide="music"></i> TikTok
                    </a>
                    {% endif %}
                    {% if youtube %}
                    <a href="{{ youtube | ensureUrl }}" target="_blank" rel="noopener" class="profil-sosial-btn" aria-label="YouTube">
                        <i data-lucide="youtube"></i> YouTube
                    </a>
                    {% endif %}
                    {% if website %}
                    <a href="{{ website | ensureUrl }}" target="_blank" rel="noopener" class="profil-sosial-btn" aria-label="Website">
                        <i data-lucide="globe"></i> Website
                    </a>
                    {% endif %}
                    {% if github %}
                    <a href="{{ github | ensureUrl }}" target="_blank" rel="noopener" class="profil-sosial-btn" aria-label="GitHub">
                        <i data-lucide="github"></i> GitHub
                    </a>
                    {% endif %}
                    {% if orcid %}
                    <a href="{{ orcid | ensureUrl }}" target="_blank" rel="noopener" class="profil-sosial-btn" aria-label="ORCID">
                        <i data-lucide="book-open"></i> ORCID
                    </a>
                    {% endif %}
                    {% if scholar %}
                    <a href="{{ scholar | ensureUrl }}" target="_blank" rel="noopener" class="profil-sosial-btn" aria-label="Google Scholar">
                        <i data-lucide="graduation-cap"></i> Scholar
                    </a>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>

    <div class="container profil-body">
        {% include "components/breadcrumb.njk" %}
        <br>
        <div class="profil-grid">
            <!-- Sidebar Kiri -->
            <aside class="profil-sidebar">
                
                {# Bio #}
                <div class="profil-card">
                    <h3><i data-lucide="user-circle" class="icon-sm"></i> Tentang</h3>
                    <div class="profil-bio-text">{{ content | safe }}</div>
                </div>

                {# Education #}
                {% if pendidikan %}
                <div class="profil-card">
                    <h3><i data-lucide="graduation-cap" class="icon-sm"></i> Pendidikan</h3>
                    {% for edu in pendidikan %}
                    <div class="profil-timeline-item">
                        <strong>{{ edu.gelar }}</strong>
                        <span class="profil-timeline-place">{{ edu.institusi }}</span>
                        <span class="profil-timeline-year">{{ edu.tahun }}</span>
                    </div>
                    {% endfor %}
                </div>
                {% endif %}

                {# Keahlian #}
                {% if tags %}
                <div class="profil-card">
                    <h3><i data-lucide="tag" class="icon-sm"></i> Bidang Keahlian</h3>
                    <div class="profil-tags">
                        {% for tag in tags %}
                        {% if tag != "penulis" %}
                        <span class="profil-tag">{{ tag }}</span>
                        {% endif %}
                        {% endfor %}
                    </div>
                </div>
                {% endif %}

            </aside>

            {# ═══ Main Content - Articles ═══ #}
            <main class="profil-main">
                <h2 class="profil-section-title">
                    <i data-lucide="pencil" class="icon-sm"></i>
                    Artikel oleh {{ title }}
                </h2>
                
                {% set hasArticles = false %}
                {% for item in collections.semuaArtikel %}
                    {% if item.data.penulis == page.fileSlug %}
                        {% set hasArticles = true %}
                    {% endif %}
                {% endfor %}

                {% if not hasArticles %}
                <div class="profil-empty">
                    <i data-lucide="file-x"></i>
                    <p>Belum ada artikel yang diterbitkan.</p>
                </div>
                {% else %}
                <div class="profil-artikel-list">
                    {% for item in collections.semuaArtikel | sort(true, false, "date") %}
                        {% if item.data.penulis == page.fileSlug %}
                        <a href="{{ item.url }}" class="profil-artikel-card">
                            {% if item.data.image %}
                            <div class="profil-artikel-img" style="background-image: url('{{ item.data.image }}')"></div>
                            {% endif %}
                            <div class="profil-artikel-body">
                                {% if item.data.category %}
                                <span class="profil-artikel-kategori">{{ item.data.category | replace("-", " ") | title }}</span>
                                {% endif %}
                                <h4 class="profil-artikel-judul">{{ item.data.title }}</h4>
                                <p class="profil-artikel-desc">{{ item.data.description | default("") | truncate(120) }}</p>
                                <div class="profil-artikel-meta">
                                    <span><i data-lucide="calendar" class="icon-xs"></i> {{ item.date | tanggalBaca }}</span>
                                    <span><i data-lucide="clock" class="icon-xs"></i> {{ item.content | waktuBaca }} menit baca</span>
                                </div>
                            </div>
                        </a>
                        {% endif %}
                    {% endfor %}
                </div>
                {% endif %}
            </main>
        </div>
    </div>
</div>
