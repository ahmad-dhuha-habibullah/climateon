---
layout: layouts/base.njk
---

{% set meta = null %}
{% for item in collections.halaman_kategori %}
  {% if item.fileSlug == collectionName %}
    {% set meta = item.data %}
  {% endif %}
{% endfor %}

{# ═══ Category Header ═══ #}
<section class="kategori-header {% if meta.image or meta.video %}has-bg{% endif %}">
    {% if meta.video %}
    <video class="beranda-bg-media" autoplay loop muted playsinline>
        <source src="{{ meta.video }}" type="video/webm">
        {% if meta.image %}
        <source src="{{ meta.image }}" type="image/jpeg">
        {% endif %}
    </video>
    {% elif meta.image %}
    <div class="beranda-bg-media" style="background-image: url('{{ meta.image }}');"></div>
    {% endif %}

    {% if meta.image or meta.video %}
    <div class="beranda-gradient-overlay" style="opacity: 0.85;"></div>
    {% endif %}

    <div class="container" style="position: relative; z-index: 2;">
        {% include "components/breadcrumb.njk" %}
        <br>
        <h1>{{ meta.title | default(title) }}</h1>
        {% if meta.description or description %}
        <p class="kategori-desc">{{ meta.description | default(description) }}</p>
        {% endif %}

        {# Subtopik tags #}
        {% if meta.subtopik and meta.subtopik.length %}
        <div class="subtopik-pills">
            {% for sub in meta.subtopik %}
            <span class="subtopik-pill">{{ sub }}</span>
            {% endfor %}
        </div>
        {% elif subtopik and subtopik.length %}
        <div class="subtopik-pills">
            {% for sub in subtopik %}
            <span class="subtopik-pill">{{ sub }}</span>
            {% endfor %}
        </div>
        {% endif %}
    </div>
</section>


{# ═══ All Articles Grid ═══ #}
<section class="section section-alt">
    <div class="container">
        <div class="section-title">
            <h2>Semua Artikel</h2>
            <span class="artikel-count">{{ collections[collectionName].length }} artikel</span>
        </div>

        {% if pagination.items.length > 0 %}
        <div class="grid-cards grid-4">
            {% for item in pagination.items %}
                {% include "components/kartu-standar.njk" %}
            {% endfor %}
        </div>

        {# Paginasi UI #}
        {% if pagination.pages.length > 1 %}
        <div class="pagination">
            <nav aria-label="Navigasi Halaman">
                <ol class="pagination-list">
                    <li>
                        {% if pagination.href.previous %}
                        <a href="{{ pagination.href.previous }}" class="pagination-link" aria-label="Halaman Sebelumnya"><i data-lucide="chevron-left" class="icon-xs"></i> Prev</a>
                        {% else %}
                        <span class="pagination-link disabled"><i data-lucide="chevron-left" class="icon-xs"></i> Prev</span>
                        {% endif %}
                    </li>
                    
                    {% for pageEntry in pagination.pages %}
                    <li>
                        <a href="{{ pagination.hrefs[ loop.index0 ] }}" class="pagination-link {% if page.url == pagination.hrefs[ loop.index0 ] %}active{% endif %}" aria-current="{% if page.url == pagination.hrefs[ loop.index0 ] %}page{% endif %}">{{ loop.index }}</a>
                    </li>
                    {% endfor %}

                    <li>
                        {% if pagination.href.next %}
                        <a href="{{ pagination.href.next }}" class="pagination-link" aria-label="Halaman Berikutnya">Next <i data-lucide="chevron-right" class="icon-xs"></i></a>
                        {% else %}
                        <span class="pagination-link disabled">Next <i data-lucide="chevron-right" class="icon-xs"></i></span>
                        {% endif %}
                    </li>
                </ol>
            </nav>
        </div>
        {% endif %}

        {% else %}
        <div class="empty-state">
            <i data-lucide="file-x" class="empty-icon"></i>
            <p>Belum ada artikel di kategori ini.</p>
        </div>
        {% endif %}
    </div>
</section>

