---
layout: layouts/base.njk
---

{# ═══ Category Header ═══ #}
<section class="kategori-header">
    <div class="container">
        <h1>{{ title }}</h1>
        {% if description %}
        <p class="kategori-desc">{{ description }}</p>
        {% endif %}

        {# Subtopik tags #}
        {% if subtopik and subtopik.length %}
        <div class="subtopik-pills">
            {% for sub in subtopik %}
            <span class="subtopik-pill">{{ sub }}</span>
            {% endfor %}
        </div>
        {% endif %}
    </div>
</section>

{# ═══ Featured Article ═══ #}
{% set artikelKategori = collections[collectionName] %}
{% set artikelUnggulan = artikelKategori | featured | limit(1) %}
{% set artikelPertama = artikelUnggulan[0] or artikelKategori[0] %}

{% if artikelPertama %}
<section class="section">
    <div class="container">
        {% include "components/kartu-hero.njk" %}
    </div>
</section>
{% endif %}

{# ═══ All Articles Grid ═══ #}
<section class="section section-alt">
    <div class="container">
        <div class="section-title">
            <h2>Semua Artikel</h2>
            <span class="artikel-count">{{ artikelKategori.length }} artikel</span>
        </div>

        {% if artikelKategori.length > 0 %}
        <div class="grid-cards">
            {% for item in artikelKategori %}
                {% if item.url != artikelPertama.url %}
                {% include "components/kartu-standar.njk" %}
                {% endif %}
            {% endfor %}
        </div>
        {% else %}
        <div class="empty-state">
            <i data-lucide="file-x" class="empty-icon"></i>
            <p>Belum ada artikel di kategori ini.</p>
        </div>
        {% endif %}
    </div>
</section>
