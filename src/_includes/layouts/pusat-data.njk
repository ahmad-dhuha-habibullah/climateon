---
layout: layouts/base.njk
---

{# ═══ Data Hub Monitor Page ═══ #}
<section class="datahub-hero">
    <div class="container">
        <div class="datahub-breadcrumb">
            <a href="/pusat-data/">Pusat Data</a>
            <i data-lucide="chevron-right" class="icon-xs"></i>
            <span>{{ title }}</span>
        </div>
        <h1>{{ title }}</h1>
        <p class="datahub-desc">{{ description }}</p>
    </div>
</section>

<section class="section">
    <div class="container">

        {# Visualization / Embed #}
        {% if embedUrl %}
        <div class="datahub-viz-container" style="margin-bottom: var(--space-xl); border-radius: var(--radius-lg); overflow: hidden; box-shadow: 0 4px 20px rgba(0,0,0,0.1);">
            <iframe src="{{ embedUrl | ensureUrl }}" width="100%" height="700" frameborder="0" allowfullscreen></iframe>
        </div>
        {% endif %}

        {# Content #}
        <div class="datahub-content">
            {{ content | safe }}
        </div>
        
    </div>
</section>
