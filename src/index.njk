---
layout: layouts/base.njk
title: "ClimateOn"
description: "Platform intelijen iklim Indonesia yang menyajikan analisis mendalam, cerita berbasis data, dan pemantauan kondisi iklim dalam format jurnalisme modern."
---

{# ═══ HERO BERANDA ═══ #}
{% include "components/beranda-hero.njk" %}


{# ═══ ARTIKEL PILIHAN ═══ #}
{% set featuredList = collections.unggulan | exclude(heroArticle.url) | limit(4) %}
{% if featuredList.length == 0 %}
    {% set featuredList = collections.semuaArtikel | exclude(heroArticle.url) | limit(4) %}
{% endif %}

{% if featuredList.length > 0 %}
<section class="section">
    <div class="container">
        <div class="section-title">
            <h2>Pilihan Redaksi</h2>
        </div>
        <div class="grid-cards grid-4">
            {% for item in featuredList %}
                {% include "components/kartu-utama.njk" %}
            {% endfor %}
        </div>
    </div>
</section>
{% endif %}

{# ═══ ARTIKEL TERBARU ═══ #}
{% set latestArticles = collections.semuaArtikel | exclude(heroArticle.url) | limit(6) %}
{% if latestArticles.length > 0 %}
<section class="section section-alt">
    <div class="container">
        <div class="section-title">
            <h2>Terbaru</h2>
        </div>
        <div class="grid-cards grid-3">
            {% for item in latestArticles %}
                {% include "components/kartu-standar.njk" %}
            {% endfor %}
        </div>
    </div>
</section>
{% endif %}

{# ═══ IKLIM ═══ #}
{% set iklimItems = collections.iklim %}
{% if iklimItems.length > 0 %}
{% set sectionTitle = "Iklim" %}
{% set sectionUrl = "/iklim/" %}
{% set items = iklimItems %}
