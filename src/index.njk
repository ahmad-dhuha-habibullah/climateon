---
layout: layouts/base.njk
title: "Beranda - Climateon.id"
---

<!-- Hero Section -->
<section class="hero">
    <div class="container">
        <h1>Memahami Iklim Indonesia Melalui Data</h1>
        <p>Artikel, analisis, visualisasi, dan pemantauan iklim untuk membantu masyarakat memahami perubahan lingkungan yang terjadi di sekitar kita.</p>
        <div class="hero-actions">
            <a href="/iklim-dijelaskan/" class="btn btn-primary">Jelajahi Artikel</a>
            <a href="/climate-watch/" class="btn btn-outline">Lihat Climate Watch</a>
        </div>
    </div>
</section>

<!-- Memahami Iklim -->
<section class="section">
    <div class="container">
        <div class="section-title">
            <h2>Memahami Iklim</h2>
            <a href="/iklim-dijelaskan/" class="section-link">Lihat Semua</a>
        </div>
        <div class="grid-cards">
            {% for item in collections.iklim_dijelaskan %}
                {% if loop.index0 < 6 %}
                <div class="card">
                    <img src="{{ item.data.image }}" alt="{{ item.data.title }}" class="card-img">
                    <div class="card-content">
                        <span class="card-category">{{ item.data.kategori }}</span>
                        <h3 class="card-title"><a href="{{ item.url }}">{{ item.data.title }}</a></h3>
                        <p class="card-desc">{{ item.data.description }}</p>
                        <div class="card-meta">
                            <span>{{ item.date | readableDate }}</span>
                        </div>
                    </div>
                </div>
                {% endif %}
            {% endfor %}
        </div>
    </div>
</section>

<!-- Climate Watch -->
<section class="section" style="background-color: var(--color-surface);">
    <div class="container">
        <div class="section-title">
            <h2>Climate Watch</h2>
            <a href="/climate-watch/" class="section-link">Selengkapnya</a>
        </div>
        <div class="watch-grid">
            <div class="watch-card">
                <h3>ENSO</h3>
                <div class="status" style="color: #64748b;">Netral</div>
            </div>
            <div class="watch-card">
                <h3>IOD</h3>
                <div class="status" style="color: #eab308;">Positif Lemah</div>
            </div>
            <div class="watch-card">
                <h3>Anomali SST Indonesia</h3>
                <div class="status" style="color: #ef4444;">+0.4°C</div>
            </div>
            <div class="watch-card">
                <h3>Curah Hujan Nasional</h3>
                <div class="status" style="color: #0ea5e9;">Atas Normal</div>
            </div>
        </div>
    </div>
</section>

<!-- Data Story Pilihan -->
<section class="section">
    <div class="container">
        <div class="section-title">
            <h2>Data Story Pilihan</h2>
            <a href="/data-story/" class="section-link">Lihat Semua</a>
        </div>
        <div class="grid-cards">
            {% for item in collections.data_story %}
                {% if loop.index0 < 3 %}
                <div class="card">
                    <img src="{{ item.data.image }}" alt="{{ item.data.title }}" class="card-img">
                    <div class="card-content">
                        <span class="card-category">{{ item.data.kategori }}</span>
                        <h3 class="card-title"><a href="{{ item.url }}">{{ item.data.title }}</a></h3>
                    </div>
                </div>
                {% endif %}
            {% endfor %}
        </div>
    </div>
</section>

<!-- Bedah Paper Terbaru -->
<section class="section" style="background-color: var(--color-surface);">
    <div class="container">
        <div class="section-title">
            <h2>Bedah Paper Terbaru</h2>
            <a href="/bedah-paper/" class="section-link">Lihat Semua</a>
        </div>
        <div class="grid-cards">
            {% for item in collections.bedah_paper %}
                {% if loop.index0 < 3 %}
                <div class="card">
                    <div class="card-content">
                        <span class="badge badge-blue mb-4">Bedah Paper</span>
                        <h3 class="card-title"><a href="{{ item.url }}">{{ item.data.title }}</a></h3>
                        <p class="card-desc">{{ item.data.description }}</p>
                        <div class="card-meta">
                            <span>{{ item.data.jurnal }} ({{ item.data.tahun }})</span>
                        </div>
                    </div>
                </div>
                {% endif %}
            {% endfor %}
        </div>
    </div>
</section>

<!-- Peristiwa Ekstrem -->
<section class="section">
    <div class="container">
        <div class="section-title">
            <h2>Peristiwa Ekstrem</h2>
            <a href="/peristiwa-ekstrem/" class="section-link">Lihat Semua</a>
        </div>
        <div class="grid-cards">
            {% for item in collections.peristiwa_ekstrem %}
                {% if loop.index0 < 3 %}
                <div class="card">
                    <img src="{{ item.data.image }}" alt="{{ item.data.title }}" class="card-img">
                    <div class="card-content">
                        <span class="card-category">{{ item.data.kategori }}</span>
                        <h3 class="card-title"><a href="{{ item.url }}">{{ item.data.title }}</a></h3>
                        <p class="card-desc">{{ item.data.description }}</p>
                    </div>
                </div>
                {% endif %}
            {% endfor %}
        </div>
    </div>
</section>
