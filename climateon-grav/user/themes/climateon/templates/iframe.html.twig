{% extends 'partials/base.html.twig' %}

{% block content %}
    <div class="iframe-container">
        <header class="page-header container">
            <h1>{{ page.title }}</h1>
            <p>{{ page.header.description }}</p>
        </header>
        
        <iframe 
            src="{{ page.header.iframe_url }}" 
            width="100%" 
            height="800px" 
            frameborder="0" 
            allowfullscreen>
        </iframe>
    </div>
{% endblock %}
