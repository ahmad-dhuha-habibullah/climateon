{{!< default}}

<!-- Hero Section -->
<section class="hero">
    <div class="container">
        <h1>Memahami Iklim Indonesia Melalui Data</h1>
        <p>Artikel, analisis, visualisasi, dan pemantauan iklim untuk membantu masyarakat memahami perubahan lingkungan yang terjadi di sekitar kita.</p>
        <div class="hero-actions">
            <a href="/tag/iklim-dijelaskan/" class="btn btn-primary">Jelajahi Artikel</a>
            <a href="/tag/climate-watch/" class="btn btn-outline">Lihat Climate Watch</a>
        </div>
    </div>
</section>

<!-- Memahami Iklim -->
<section class="section">
    <div class="container">
        <div class="section-title">
            <h2>Memahami Iklim</h2>
            <a href="/tag/iklim-dijelaskan/" class="section-link">Lihat Semua</a>
        </div>
        <div class="grid-cards">
            {{#get "posts" filter="tag:iklim-dijelaskan" limit="6" include="tags"}}
                {{#foreach posts}}
                <div class="card">
                    {{#if feature_image}}
                    <img src="{{img_url feature_image size="m"}}" alt="{{title}}" class="card-img">
                    {{/if}}
                    <div class="card-content">
                        {{#if primary_tag}}
                        <span class="card-category">{{primary_tag.name}}</span>
                        {{/if}}
                        <h3 class="card-title"><a href="{{url}}">{{title}}</a></h3>
                        <p class="card-desc">{{excerpt words="20"}}</p>
                        <div class="card-meta">
                            <span>{{date format="DD MMM YYYY"}}</span>
                        </div>
                    </div>
                </div>
                {{/foreach}}
            {{/get}}
        </div>
    </div>
</section>

<!-- Climate Watch -->
<section class="section" style="background-color: var(--color-surface);">
    <div class="container">
        <div class="section-title">
            <h2>Climate Watch</h2>
            <a href="/tag/climate-watch/" class="section-link">Selengkapnya</a>
        </div>
        <div class="watch-grid">
            <div class="watch-card">
                <h3>ENSO</h3>
                <div class="status" style="color: #64748b;">Netral</div>
            </div>
            <div class="watch-card">
                <h3>IOD</h3>
                <div class="status" style="color: #eab308;">Positif Lemah</div>
            </div>
            <div class="watch-card">
                <h3>Anomali SST Indonesia</h3>
                <div class="status" style="color: #ef4444;">+0.4°C</div>
            </div>
            <div class="watch-card">
                <h3>Curah Hujan Nasional</h3>
                <div class="status" style="color: #0ea5e9;">Atas Normal</div>
            </div>
        </div>
    </div>
</section>

