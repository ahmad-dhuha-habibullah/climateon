{{!< default}}

{{#post}}
<article class="article-header {{post_class}}">
    <div class="container">
        {{#if primary_tag}}
            <span class="article-category"><a href="{{primary_tag.url}}">{{primary_tag.name}}</a></span>
        {{/if}}
        
        <h1 class="article-title">{{title}}</h1>
        
        <div class="article-meta">
            <span><time datetime="{{date format="YYYY-MM-DD"}}">{{date format="DD MMM YYYY"}}</time></span>
            {{#if primary_author}}
                <span>&bull;</span>
                <span>Oleh <a href="{{primary_author.url}}">{{primary_author.name}}</a></span>
            {{/if}}
        </div>
    </div>
</article>

<div class="container" style="max-width: 800px; padding-bottom: 4rem;">
    {{#if feature_image}}
        <img src="{{img_url feature_image}}" alt="{{title}}" class="article-cover">
    {{/if}}

    <div class="article-content">
        {{content}}
    </div>
</div>
{{/post}}
